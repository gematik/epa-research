@import de.gematik.epa.poc.privacy.TestCaseResult
@import de.gematik.epa.poc.privacy.Config

@param config: Config
@param testCase: TestCaseResult

<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Test case</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- Highlight.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <!-- Diff2Html -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/diff2html/bundles/css/diff2html.min.css" />
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/diff2html/bundles/js/diff2html-ui.min.js"></script>
    <!-- Custom -->
    <link rel="stylesheet" href="reports.css">

</head>
<body>

<div class="container my-5 centered-container">

<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">gematik</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Privacy test cases
                    </a>
                    <ul class="dropdown-menu">
                        @for (testCaseConfig in config.testCaseList)
                        <li><a class="dropdown-item" href="${testCaseConfig.id}.html">${testCaseConfig.title}</a></li>
                        @endfor
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<h2 class="mt-4 mb-4">${testCase.testCaseConfig.title}</h2>

    <ul class="nav nav-tabs" id="reportTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="diff-tab" data-bs-toggle="tab" data-bs-target="#diff" type="button" role="tab" aria-controls="diff" aria-selected="true">Diff</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="filter-tab" data-bs-toggle="tab" data-bs-target="#filter" type="button" role="tab" aria-controls="filter" aria-selected="false">P-Profile</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="validation-tab" data-bs-toggle="tab" data-bs-target="#validation" type="button" role="tab" aria-controls="validation" aria-selected="false">Validation</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sources-tab" data-bs-toggle="tab" data-bs-target="#sources" type="button" role="tab" aria-controls="sources" aria-selected="false">Sources</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="resources-tab" data-bs-toggle="tab" data-bs-target="#resources" type="button" role="tab" aria-controls="resources" aria-selected="false">ePA Resources</button>
        </li>
    </ul>

    <div class="tab-content pt-4" id="reportTabsContent">
        <div class="tab-pane fade" id="filter" role="tabpanel" aria-labelledby="filter-tab">
            <h3>Filtered values</h3>
            <table class="table">
                <thead>
                <tr>
                    <th>Path</th>
                    <th>Privacy Filter</th>
                </tr>
                </thead>
                <tbody>
                @for(message in testCase.filterLog)
                    <tr>
                        <td><code>${message.path}</code></td>
                        <td class="${message.severity}">${message.message}</td>
                    </tr>
                @endfor
                </tbody>
            </table>
            <h3 class="mt-4">Job Numbers (Arbeitsnummer)</h3>
            <table class="table">
                <thead>
                <tr>
                    <th>Job Number</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                @for(pseudonym in testCase.pseudonyms)
                    <tr>
                        <td>${pseudonym.value}</td>
                        <td>${pseudonym.key}</td>
                    </tr>
                @endfor
                </tbody>
            </table>
        </div>

        <div class="tab-pane fade show active" id="diff" role="tabpanel" aria-labelledby="diff-tab">
            <div id="bundleDiff"></div>
        </div>

        <div class="tab-pane fade" id="validation" role="tabpanel" aria-labelledby="validation-tab">
            <div class="row">
                <div class="col-xl-6">
                    <h4>Validation before filter</h4>
                    @if(testCase.validationMessages.size > 0)
                        <table class="table table-sm">
                            <tbody>
                            @for(message in testCase.validationMessages)
                                <tr>
                                    <td><span class="${message.severity}">${message.severity}</span> <code>${message.location}</code><br>${message.message}</td>
                                </tr>
                            @endfor
                            </tbody>
                        </table>
                    @else
                        <p class="text-success">Bundle is valid</p>
                    @endif
                </div>
                <div class="col-xl-6">
                    <h4>Validation after filter</h4>
                    @if(testCase.filteredValidationMessages.size > 0)
                        <table class="table table-sm">
                            <tbody>
                            @for(message in testCase.filteredValidationMessages)
                                <tr>
                                    <td><span class="${message.severity}">${message.severity}</span> <code>${message.location}</code><br>${message.message}</td>
                                </tr>
                            @endfor
                            </tbody>
                        </table>
                    @else
                        <p class="text-success">Bundle is valid</p>
                    @endif
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="sources" role="tabpanel" aria-labelledby="sources-tab">
            @for (source in testCase.sources)
                <h3>${source.title}</h3>
                <div>
                    <pre><code class="language-vbnet">${source.content}</code></pre>
                </div>
            @endfor
        </div>

        <div class="tab-pane fade" id="resources" role="tabpanel" aria-labelledby="resources-tab">
            <pre><code class="language-json">${testCase.bundleJson}</code></pre>
        </div>
    </div>

    <script type="text/javascript">
        // Render the diff lazily the first time its tab is shown — diff2html needs the target
        // element to be visible to size correctly.
        let diffRendered = false;
        function renderBundleDiff() {
            if (diffRendered) return;
            diffRendered = true;
            const targetElement = document.getElementById('bundleDiff');
            const diffString = $unsafe{testCase.bundleDiff};
            const diff2htmlUi = new Diff2HtmlUI(targetElement, diffString, {
                drawFileList: false,
                fileListToggle: false,
                fileListStartVisible: false,
                fileContentToggle: false,
                matching: 'lines',
                outputFormat: 'side-by-side',
                synchronisedScroll: true,
                highlight: true,
                colorScheme: 'dark',
                renderNothingWhenEmpty: false,
            });
            diff2htmlUi.draw();
            diff2htmlUi.highlightCode();
        }
        document.getElementById('diff-tab').addEventListener('shown.bs.tab', renderBundleDiff);
        // Diff is the default active tab — render immediately on load.
        document.addEventListener('DOMContentLoaded', renderBundleDiff);
    </script>

    <%--
<h2 class="mt-4 mb-4">Profiles</h2>
<table class="table">
    <thead>
    <tr>
        <th>Path</th>
        <th>Type</th>
        <th>N..M</th>
        <th>MS</th>
        <th>Privacy Label</th>
    </tr>
    </thead>
    <tbody>
    @for(element in testCase.profile.snapshot.element)
        <tr>
            <td>${element.path}</td>
            <td>${element.type.firstOrNull()?.code}</td>
            <td>
                @if(element.min > 0)
                    <span class="text-success">${element.min}..${element.max}</span>
                @else
                    <span>${element.min}..${element.max}</span>
                @endif
            </td>
            <td>
                @if(element.mustSupport)
                    <span class="text-success">MS</span>
                @else
                    <span></span>
                @endif
            </td>
            <td>-</td>
        </tr>
    @endfor
    </tbody>
</table>
--%>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script>hljs.highlightAll();</script>

</body>
</html>
